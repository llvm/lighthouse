#!/usr/bin/env python
"""
xemm - compile and run the matmul example end to end.

Reads a matmul parameter JSON file (same format as
lighthouse/schedule/xegpu/matmul_params.json), generates the "outlined" kernel
IR with the matmul example, assembles it into a shared library with `xeas`, and
runs it with `xerun`. The whole chain is a single pipe, so the shared
library is never written to disk.

The parameter section is selected by `--sizes M N K`, which is matched against
the `m`, `n`, `k` fields of the sections. If `--sizes` is omitted, the first
section in the JSON is used.

Examples:
    # compile and run the first section
    xemm params.json

    # select a section by its sizes and run it
    xemm params.json --sizes 4096 4096 4096
"""

import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
XEAS = os.path.join(HERE, "xeas")
XERUN = os.path.join(HERE, "xerun")
MATMUL = os.path.normpath(os.path.join(HERE, "..", "examples", "xegpu", "matmul.py"))


def param_args(s):
    """Translate a matmul parameter section into explicit CLI arguments.

    The argument names are shared by matmul.py and xeas.
    """
    a = ["--sizes", str(s["m"]), str(s["n"]), str(s["k"])]
    if "wg_m" in s and "wg_n" in s:
        a += ["--wg-tile", str(s["wg_m"]), str(s["wg_n"])]
    if "sg_m" in s and "sg_n" in s:
        a += ["--sg-tile", str(s["sg_m"]), str(s["sg_n"])]
    if "k_tile" in s:
        a += ["--k-tile", str(s["k_tile"])]
    if "load_a_m" in s and "load_a_k" in s:
        a += ["--load-tile-a", str(s["load_a_m"]), str(s["load_a_k"])]
    if "load_b_k" in s and "load_b_n" in s:
        a += ["--load-tile-b", str(s["load_b_k"]), str(s["load_b_n"])]
    if "prefetch_a_m" in s and "prefetch_a_k" in s:
        a += ["--prefetch-tile-a", str(s["prefetch_a_m"]), str(s["prefetch_a_k"])]
    if "prefetch_b_k" in s and "prefetch_b_n" in s:
        a += ["--prefetch-tile-b", str(s["prefetch_b_k"]), str(s["prefetch_b_n"])]
    if "prefetch_a_nb" in s:
        a += ["--prefetch-a-nb", str(s["prefetch_a_nb"])]
    if "prefetch_b_nb" in s:
        a += ["--prefetch-b-nb", str(s["prefetch_b_nb"])]
    if s.get("transpose_a"):
        a.append("--transpose-a")
    if s.get("transpose_b"):
        a.append("--transpose-b")
    if "device" in s:
        a += ["--target", str(s["device"])]
    return a


def input_shape_arg(s, ab_type):
    """Build the xerun --input-shape descriptor for a matmul parameter section.

    The matmul payload takes its buffers in the order [C, A, B] with C in the
    accumulation type (f32) and A, B in `ab_type`. The A/B shapes follow the
    transpose flags, matching the IR that was lowered.
    """
    m, n, k = s["m"], s["n"], s["k"]
    a_shape = (k, m) if s.get("transpose_a") else (m, k)
    b_shape = (n, k) if s.get("transpose_b") else (k, n)
    descriptors = [
        f"{m}x{n}xf32x0",
        f"{a_shape[0]}x{a_shape[1]}x{ab_type}xrnd",
        f"{b_shape[0]}x{b_shape[1]}x{ab_type}xrnd",
    ]
    return ",".join(descriptors)


def parse_args():
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "json",
        help="Matmul parameter JSON file (matmul_params.json format).",
    )
    parser.add_argument(
        "--sizes",
        type=int,
        nargs=3,
        metavar=("M", "N", "K"),
        help="Select the parameter section matching these M N K sizes. "
        "Defaults to the first section.",
    )
    parser.add_argument(
        "--entry-point",
        default="payload",
        help="Name of the entry function to expose for external linking.",
    )
    parser.add_argument(
        "--ab-type",
        choices=["f16", "bf16"],
        default="f16",
        help="Data type of the A and B matrices.",
    )
    parser.add_argument(
        "-v",
        "--verbose",
        action="store_true",
        help="Print the executed command line.",
    )
    return parser.parse_args()


def main():
    args = parse_args()

    with open(args.json) as f:
        data = json.load(f)
    sections = data if isinstance(data, list) else [data]

    if args.sizes is None:
        section = sections[0]
    else:
        m, n, k = args.sizes
        matches = [
            s
            for s in sections
            if s.get("m") == m and s.get("n") == n and s.get("k") == k
        ]
        if not matches:
            sys.exit(
                f"error: no parameter section with sizes {m} {n} {k} in {args.json}"
            )
        section = matches[0]

    params = param_args(section)

    # matmul.py emits the payload IR; --ab-type is a matmul-only knob.
    matmul_cmd = [
        sys.executable,
        MATMUL,
        "--dump-kernel=outlined",
        "--ab-type",
        args.ab_type,
    ] + params
    # xeas assembles the IR into a shared library, streamed on stdout.
    xeas_cmd = (
        [sys.executable, XEAS, "-", "--entry-point", args.entry_point]
        + params
        + ["-o", "-"]
    )

    # Run mode: matmul | xeas | xerun, with the shared library streamed through
    # the pipe so it never touches the filesystem.
    xerun_cmd = [
        sys.executable,
        XERUN,
        "-",
        "--input-shape",
        input_shape_arg(section, args.ab_type),
        "--entry-point",
        args.entry_point,
    ]
    if args.verbose:
        print(
            "Running:",
            " ".join(matmul_cmd),
            "|",
            " ".join(xeas_cmd),
            "|",
            " ".join(xerun_cmd),
            file=sys.stderr,
        )
    matmul_proc = subprocess.Popen(matmul_cmd, stdout=subprocess.PIPE)
    xeas_proc = subprocess.Popen(
        xeas_cmd, stdin=matmul_proc.stdout, stdout=subprocess.PIPE
    )
    xerun_proc = subprocess.Popen(xerun_cmd, stdin=xeas_proc.stdout)
    # Let each upstream stage receive SIGPIPE if a downstream stage exits.
    matmul_proc.stdout.close()
    xeas_proc.stdout.close()
    xerun_rc = xerun_proc.wait()
    xeas_rc = xeas_proc.wait()
    matmul_rc = matmul_proc.wait()

    if matmul_rc != 0:
        sys.exit(matmul_rc)
    if xeas_rc != 0:
        sys.exit(xeas_rc)
    sys.exit(xerun_rc)


if __name__ == "__main__":
    main()
