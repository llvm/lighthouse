#!/usr/bin/env python
"""xeas - Xe assembler (command line interface).

Compiles an "outlined" MLIR payload down to a serialized GPU kernel binary blob
(the device kernel embedded by the Xe pipeline in a ``gpu.binary`` op). The blob
is the exact byte string the Level Zero runtime loads at run time, so ``xerun``
can launch the kernel directly from it without any host-side launcher.

The compilation itself lives in the importable :mod:`lighthouse.tools.xeas`
module (``xeas``/``lower_payload``/``extract_gpu_binary``); this executable only
owns the command-line interface.

Examples:
    # produce the kernel blob on stdout
    matmul.py --dump-kernel=outlined | xeas - --sizes 4096 4096 4096 > payload.bin

    # produce the kernel blob in a file
    xeas kernel.mlir --sizes 4096 4096 4096 -o payload.bin

    # let xeas infer the sizes from the kernel signature
    xeas kernel.mlir -o payload.bin

    # rewrite a dynamically shaped kernel to static shapes
    xeas kernel.mlir \
        --input-shape 4096x4096xf32,4096x4096xf16,4096x4096xf16 -o payload.bin
"""

import argparse
import json as json_lib
import sys

from lighthouse.tools.xeas import xeas
from lighthouse import dialects as _lh_dialects
from mlir import ir


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="xeas",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "input",
        nargs="?",
        default="-",
        help="Input MLIR file at the 'outlined' stage. Reads from stdin if '-' "
        "or omitted.",
    )
    parser.add_argument(
        "--input-shape",
        help="Comma-separated argument descriptors in DIMSxTYPE format (e.g. "
        "4096x4096xf32,4096x4096xf16,4096x4096xf16), one per kernel argument in "
        "order. When provided, xeas rewrites the gpu.func kernel's dynamically "
        "shaped memref arguments to these static shapes.",
    )
    parser.add_argument(
        "--assume-in-bounds",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Mark vector.transfer_read/write ops that omit the 'in_bounds' "
        "attribute as fully in-bounds so convert-vector-to-xegpu can lower "
        "them to XeGPU block loads/stores. The Xe block-load path assumes "
        "in-bounds accesses, so this is required for externally generated "
        "payloads (e.g. cutile kernels) that omit in_bounds. Disable with "
        "--no-assume-in-bounds.",
    )
    parser.add_argument(
        "-o",
        "--output",
        default="-",
        help="Output GPU kernel blob file. Writes to stdout if '-' (default).",
    )

    # Problem size and layout (must match the IR that was outlined).
    parser.add_argument(
        "--sizes",
        type=int,
        nargs=3,
        metavar=("M", "N", "K"),
        help="Problem sizes M N K (A=MxK, B=KxN, C=MxN). Used to select the "
        "XeGPU tile parameters. Inferred from the payload's static memref "
        "argument shapes when omitted.",
    )
    parser.add_argument(
        "--transpose-a",
        action="store_true",
        help="Matrix A is transposed (KxM). Must match the outlined IR.",
    )
    parser.add_argument(
        "--transpose-b",
        action="store_true",
        help="Matrix B is transposed (NxK). Must match the outlined IR.",
    )

    # Tunable tile parameters used by the XeGPU WG annotation stage.
    parser.add_argument(
        "--wg-tile",
        type=int,
        nargs=2,
        help="Workgroup tile size M,N (matmul and elementwise).",
    )
    parser.add_argument(
        "--sg-tile",
        type=int,
        nargs=2,
        help="Subgroup tile size M,N (matmul and elementwise).",
    )
    parser.add_argument(
        "--load-tile",
        type=int,
        nargs=2,
        help="Load tile size M,N for an elementwise layer.",
    )
    parser.add_argument(
        "--k-tile",
        type=int,
        help="Inner reduction dimension tile size K.",
    )
    parser.add_argument(
        "--load-tile-a",
        type=int,
        nargs=2,
        help="Tile size for loading A matrix for DPAS op.",
    )
    parser.add_argument(
        "--load-tile-b",
        type=int,
        nargs=2,
        help="Tile size for loading B matrix for DPAS op.",
    )
    parser.add_argument(
        "--prefetch-tile-a",
        type=int,
        nargs=2,
        help="Tile size for cooperative prefetching of subgroup A matrix.",
    )
    parser.add_argument(
        "--prefetch-tile-b",
        type=int,
        nargs=2,
        help="Tile size for cooperative prefetching of subgroup B matrix.",
    )
    parser.add_argument(
        "--prefetch-a-nb",
        type=int,
        help="Number of initial prefetches for A matrix.",
    )
    parser.add_argument(
        "--prefetch-b-nb",
        type=int,
        help="Number of initial prefetches for B matrix.",
    )
    parser.add_argument(
        "--json",
        help="Read problem sizes and tile parameters from a JSON file.",
    )
    parser.add_argument(
        "--target",
        choices=["B70", "B50"],
        help="Target GPU device for parameter selection, e.g., B70.",
    )

    # XeGPU-to-binary lowering options.
    parser.add_argument(
        "--xegpu-op-level",
        default="workgroup",
        help="Initial XeGPU operation level for the lowering pipeline.",
    )
    parser.add_argument(
        "--large-register-file",
        action=argparse.BooleanOptionalAction,
        default=True,
        help="Enable the large register file IGC option.",
    )
    return parser.parse_args(argv)


def build_params(args):
    """Assemble the schedule parameter dict from the command line arguments.

    Only values explicitly provided on the command line are included; anything
    omitted (problem sizes, transpose flags) is left for xeas to infer from the
    payload. Tile parameters supplied here override the schedule's own
    selection.
    """
    params = {}
    if args.sizes is not None:
        params["m"], params["n"], params["k"] = args.sizes
        params["transpose_a"] = args.transpose_a
        params["transpose_b"] = args.transpose_b
    if args.target is not None:
        params["device"] = args.target

    cli_params = {}
    if args.wg_tile:
        cli_params["wg_m"], cli_params["wg_n"] = args.wg_tile
    if args.sg_tile:
        cli_params["sg_m"], cli_params["sg_n"] = args.sg_tile
    if args.load_tile:
        cli_params["load_m"], cli_params["load_n"] = args.load_tile
    if args.k_tile:
        cli_params["k_tile"] = args.k_tile
    if args.load_tile_a:
        cli_params["load_a_m"], cli_params["load_a_k"] = args.load_tile_a
    if args.load_tile_b:
        cli_params["load_b_k"], cli_params["load_b_n"] = args.load_tile_b
    if args.prefetch_tile_a:
        cli_params["prefetch_a_m"], cli_params["prefetch_a_k"] = args.prefetch_tile_a
    if args.prefetch_tile_b:
        cli_params["prefetch_b_k"], cli_params["prefetch_b_n"] = args.prefetch_tile_b
    if args.prefetch_a_nb is not None:
        cli_params["prefetch_a_nb"] = args.prefetch_a_nb
    if args.prefetch_b_nb is not None:
        cli_params["prefetch_b_nb"] = args.prefetch_b_nb

    if args.json:
        with open(args.json, "r") as f:
            params.update(json_lib.load(f))
    params.update(cli_params)

    return params


def write_output(library: bytes, output: str):
    """Write the kernel blob to a file, or to stdout when output is '-'."""
    if output == "-":
        sys.stdout.buffer.write(library)
        sys.stdout.buffer.flush()
    else:
        with open(output, "wb") as f:
            f.write(library)


def main(argv=None):
    args = parse_args(argv)

    source = sys.stdin.read() if args.input == "-" else open(args.input).read()
    params = build_params(args)

    try:
        with ir.Context():
            _lh_dialects.register_and_load()
            library = xeas(
                source,
                params=params,
                input_shape=args.input_shape,
                assume_in_bounds=args.assume_in_bounds,
                xegpu_op_level=args.xegpu_op_level,
                large_register_file=args.large_register_file,
            )
    except Exception as exc:
        sys.exit(f"xeas: error: {exc}")

    write_output(library, args.output)


if __name__ == "__main__":
    main()
