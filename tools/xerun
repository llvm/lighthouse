#!/scratch/fschlimb/github/lighthouse/.venv/bin/python
"""xerun - run a prebuilt Xe shared library (command line interface).

Loads a shared library (.so) such as the one produced by `xeas` and runs its
entry function once. Compilation (IR -> .so) and execution are fully decoupled,
so the same library can be run repeatedly without recompiling.

A bare .so carries no information about the kernel's argument buffers, so their
shapes and element types are described on the command line with `--input-shape`,
using the same "DIMSxTYPE" format as `xeas` (e.g. `1024x1024xf32,1024x1024xf16`).
The buffers are passed in the order the entry function expects them and are
zero-initialized.

The execution itself lives in the importable :mod:`lighthouse.tools.xerun`
module (``xerun``); this executable only owns the command-line interface.

Examples:
    # run a matmul library once (C, A, B buffers)
    xerun payload.so \\
        --input-shape 4096x4096xf32,4096x4096xf16,4096x4096xf16

    # pipe the library straight from xeas (read from stdin)
    xeas kernel.mlir --entry-point payload --sizes 4096 4096 4096 | xerun \\
        --input-shape 4096x4096xf32,4096x4096xf16,4096x4096xf16
"""

import argparse
import contextlib
import sys
import tempfile

from lighthouse.execution.init import KernelArgumentParser
from lighthouse.tools.xerun import xerun


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="xerun",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "library",
        nargs="?",
        default="-",
        help="Prebuilt shared library (.so) to run, e.g. the output of xeas. "
        "Reads the library from stdin if '-' or omitted.",
    )
    parser.add_argument(
        "--input-shape",
        required=True,
        help="Comma-separated buffer descriptors in DIMSxTYPE format, in "
        "the order the entry function expects them. DIMS is MxNx... , TYPE is "
        "one of f16/f32/f64/bf16/i8/i16/i32/i64. Buffers are zero-initialized.",
    )
    parser.add_argument(
        "--entry-point",
        default="payload",
        help="Name of the entry function to run.",
    )
    parser.add_argument(
        "--benchmark",
        nargs="?",
        const="__benchmark",
        default=None,
        help="Optional benchmark wrapper function name to run instead of the entry point. "
        "When provided without a value, '__benchmark' is used.",
    )
    parser.add_argument(
        "--nruns",
        type=int,
        default=100,
        help="Number of timed benchmark iterations.",
    )
    parser.add_argument(
        "--nwarmup",
        type=int,
        default=10,
        help="Number of warmup iterations before timing.",
    )
    parser.add_argument(
        "--flops",
        type=int,
        default=None,
        help="Optional floating-point operation count used to print GFLOPS.",
    )
    return parser.parse_args(argv)


@contextlib.contextmanager
def resolve_library(library):
    """Yield a filesystem path to the shared library.

    ``ctypes`` can only load a library from a file, so when the library is read
    from stdin ('-' or omitted) it is spilled to a temporary file for the
    duration of the run.
    """
    if library != "-":
        yield library
        return
    data = sys.stdin.buffer.read()
    with tempfile.TemporaryDirectory() as tmp:
        # A unique name avoids dlopen returning a cached handle for a library
        # that was loaded under the same path earlier in the process.
        with tempfile.NamedTemporaryFile(dir=tmp, suffix=".so", delete=False) as f:
            f.write(data)
            path = f.name
        yield path


def main(argv=None):
    args = parse_args(argv)

    try:
        # Build the host buffers from the descriptors, preserving their order.
        # The CLI format is DIMSxTYPE (no INIT); buffers are zero-initialized,
        # so append the shared parser's zero-init selector to each descriptor.
        spec = ",".join(f"{d.strip()}x0" for d in args.input_shape.split(","))
        buffers = [a.arg for a in KernelArgumentParser.parse_all(spec)]
    except Exception as exc:
        print(
            f"xerun: error: invalid --input-shape '{args.input_shape}': {exc}",
            file=sys.stderr,
        )
        return 1

    try:
        with resolve_library(args.library) as library:
            xerun(
                library,
                args.entry_point,
                buffers,
                benchmark=args.benchmark,
                nruns=args.nruns,
                nwarmup=args.nwarmup,
                flops=args.flops,
            )
    except Exception as exc:
        src = "stdin" if args.library == "-" else args.library
        print(
            f"xerun: error: running '{args.entry_point}' from {src} failed: "
            f"{type(exc).__name__}: {exc}",
            file=sys.stderr,
        )
        return 1

    print(f"xerun: '{args.entry_point}' completed successfully", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
