#!/scratch/fschlimb/github/lighthouse/.venv/bin/python
"""xerun - launch a Xe kernel blob (command line interface).

Loads a serialized GPU kernel binary blob (such as the one produced by `xeas`)
into the Level Zero runtime and launches its kernel once. Compilation
(IR -> blob) and execution are fully decoupled, so the same blob can be run
repeatedly without recompiling.

The blob carries no information about the kernel's argument buffers, the launch
grid or the kernel symbol name, so these are provided on the command line. The
buffer shapes and element types use the same "DIMSxTYPE" format as `xeas` (e.g.
`1024x1024xf32,1024x1024xf16`); the buffers are passed in the order the kernel
expects them and are zero-initialized.

The launch itself lives in the importable :mod:`lighthouse.tools.xerun` module
(``xerun``); this executable only owns the command-line interface.

Examples:
    # launch a matmul kernel once (C, A, B buffers)
    xerun payload.bin --kernel-name payload_kernel \\
        --grid 8 4 1 --block 256 1 1 \\
        --input-shape 4096x4096xf32,4096x4096xf16,4096x4096xf16

    # pipe the blob straight from xeas (read from stdin)
    xeas kernel.mlir --sizes 4096 4096 4096 | xerun \
        --kernel-name payload_kernel --grid 8 4 1 --block 256 1 1 \\
        --input-shape 4096x4096xf32,4096x4096xf16,4096x4096xf16
"""

import argparse
import sys

from lighthouse.execution.init import KernelArgumentParser
from lighthouse.tools.xerun import xerun


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        prog="xerun",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument(
        "blob",
        nargs="?",
        default="-",
        help="GPU kernel binary blob to launch, e.g. the output of xeas. "
        "Reads the blob from stdin if '-' or omitted.",
    )
    parser.add_argument(
        "--input-shape",
        required=True,
        help="Comma-separated buffer descriptors in DIMSxTYPE format, in "
        "the order the kernel expects them. DIMS is MxNx... , TYPE is "
        "one of f16/f32/f64/bf16/i8/i16/i32/i64. Buffers are zero-initialized.",
    )
    parser.add_argument(
        "--kernel-name",
        default="payload_kernel",
        help="Name of the kernel symbol inside the blob to launch.",
    )
    parser.add_argument(
        "--grid",
        type=int,
        nargs=3,
        required=True,
        metavar=("X", "Y", "Z"),
        help="Launch grid (number of blocks) as three dimensions X Y Z.",
    )
    parser.add_argument(
        "--block",
        type=int,
        nargs=3,
        required=True,
        metavar=("X", "Y", "Z"),
        help="Thread block size as three dimensions X Y Z.",
    )
    return parser.parse_args(argv)


def read_blob(blob):
    """Read the kernel blob bytes from a file, or from stdin when '-'."""
    if blob == "-":
        return sys.stdin.buffer.read()
    with open(blob, "rb") as f:
        return f.read()


def main(argv=None):
    args = parse_args(argv)

    try:
        # Build the host buffers from the descriptors, preserving their order.
        # The CLI format is DIMSxTYPE (no INIT); buffers are zero-initialized,
        # so append the shared parser's zero-init selector to each descriptor.
        spec = ",".join(f"{d.strip()}x0" for d in args.input_shape.split(","))
        buffers = [a.arg for a in KernelArgumentParser.parse_all(spec)]
    except Exception as exc:
        print(
            f"xerun: error: invalid --input-shape '{args.input_shape}': {exc}",
            file=sys.stderr,
        )
        return 1

    try:
        blob = read_blob(args.blob)
        xerun(
            blob,
            args.kernel_name,
            buffers,
            tuple(args.grid),
            tuple(args.block),
        )
    except Exception as exc:
        src = "stdin" if args.blob == "-" else args.blob
        print(
            f"xerun: error: launching '{args.kernel_name}' from {src} failed: "
            f"{type(exc).__name__}: {exc}",
            file=sys.stderr,
        )
        return 1

    print(f"xerun: '{args.kernel_name}' completed successfully", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
